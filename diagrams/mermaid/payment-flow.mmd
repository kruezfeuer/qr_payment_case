flowchart TD
    A["Торговая точка формирует платёжный запрос"] --> B["Проверить параметры покупки и права торговой точки"]
    B --> C{"Запрос корректен?"}

    C -->|Нет| D["Вернуть ошибку торговой точке"]
    D --> END1(["Завершение без создания запроса"])

    C -->|Да| E["Создать платёжный запрос и динамический QR"]
    E --> F["Клиент сканирует QR-код"]
    F --> G["Получить и проверить платёжный запрос"]
    G --> H{"Запрос активен и не истёк?"}

    H -->|Нет| I["Вернуть причину недоступности"]
    I --> END2(["Завершение без оплаты"])

    H -->|Да| J["Показать получателя, сумму и валюту"]
    J --> K{"Клиент подтвердил оплату?"}

    K -->|Нет| END2
    K -->|Да| L["Повторно проверить возможность оплаты"]
    L --> M{"Проверки пройдены?"}

    M -->|Нет| N["Вернуть отказ до проведения платежа"]
    N --> END2

    M -->|Да| O["Создать платёжную операцию"]
    O --> P["Передать операцию во внешнюю платёжную инфраструктуру"]
    P --> Q{"Получен итоговый результат?"}

    Q -->|Да| R{"Платёж успешен?"}
    Q -->|Нет| S["Сохранить неопределённый статус"]
    S --> T["Уточнить статус существующей операции"]
    T --> Q

    R -->|Да| U["Зафиксировать успех и пометить запрос оплаченным"]
    R -->|Нет| V["Зафиксировать окончательный отказ"]

    U --> W["Передать результат клиенту и торговой точке"]
    V --> W
    W --> END3(["Завершение"])